theorem spectral_discovered_degree_6_primal (x y w v b q c : ℝ) : c*q*(b + v*y + w*x)^6 = b^6*c*q + 6*b^5*c*q*v*y + 6*b^5*c*q*w*x + 15*b^4*c*q*v^2*y^2 + 30*b^4*c*q*v*w*x*y + 15*b^4*c*q*w^2*x^2 + 20*b^3*c*q*v^3*y^3 + 60*b^3*c*q*v^2*w*x*y^2 + 60*b^3*c*q*v*w^2*x^2*y + 20*b^3*c*q*w^3*x^3 + 15*b^2*c*q*v^4*y^4 + 60*b^2*c*q*v^3*w*x*y^3 + 90*b^2*c*q*v^2*w^2*x^2*y^2 + 60*b^2*c*q*v*w^3*x^3*y + 15*b^2*c*q*w^4*x^4 + 6*b*c*q*v^5*y^5 + 30*b*c*q*v^4*w*x*y^4 + 60*b*c*q*v^3*w^2*x^2*y^3 + 60*b*c*q*v^2*w^3*x^3*y^2 + 30*b*c*q*v*w^4*x^4*y + 6*b*c*q*w^5*x^5 + c*q*v^6*y^6 + 6*c*q*v^5*w*x*y^5 + 15*c*q*v^4*w^2*x^2*y^4 + 20*c*q*v^3*w^3*x^3*y^3 + 15*c*q*v^2*w^4*x^4*y^2 + 6*c*q*v*w^5*x^5*y + c*q*w^6*x^6 := by ring
