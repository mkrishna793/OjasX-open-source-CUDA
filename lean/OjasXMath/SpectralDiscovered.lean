theorem spectral_discovered_degree_2_primal (x y w v b q c : ℝ) : c*q*(b + v*y + w*x)^2 = b^2*c*q + 2*b*c*q*v*y + 2*b*c*q*w*x + c*q*v^2*y^2 + 2*c*q*v*w*x*y + c*q*w^2*x^2 := by ring
theorem spectral_discovered_degree_2_gradient_x (x y w v b q c : ℝ) : 2*c*q*w*(b + v*y + w*x) = 2*b*c*q*w + 2*c*q*v*w*y + 2*c*q*w^2*x := by ring
theorem spectral_discovered_degree_2_gradient_y (x y w v b q c : ℝ) : 2*c*q*v*(b + v*y + w*x) = 2*b*c*q*v + 2*c*q*v^2*y + 2*c*q*v*w*x := by ring
theorem spectral_discovered_degree_2_gradient_w (x y w v b q c : ℝ) : 2*c*q*x*(b + v*y + w*x) = 2*b*c*q*x + 2*c*q*v*x*y + 2*c*q*w*x^2 := by ring
theorem spectral_discovered_degree_2_gradient_v (x y w v b q c : ℝ) : 2*c*q*y*(b + v*y + w*x) = 2*b*c*q*y + 2*c*q*v*y^2 + 2*c*q*w*x*y := by ring
theorem spectral_discovered_degree_2_gradient_b (x y w v b q c : ℝ) : c*q*(2*b + 2*v*y + 2*w*x) = 2*b*c*q + 2*c*q*v*y + 2*c*q*w*x := by ring
theorem spectral_discovered_degree_2_gradient_q (x y w v b q c : ℝ) : c*(b + v*y + w*x)^2 = b^2*c + 2*b*c*v*y + 2*b*c*w*x + c*v^2*y^2 + 2*c*v*w*x*y + c*w^2*x^2 := by ring
theorem spectral_discovered_degree_2_gradient_c (x y w v b q c : ℝ) : q*(b + v*y + w*x)^2 = b^2*q + 2*b*q*v*y + 2*b*q*w*x + q*v^2*y^2 + 2*q*v*w*x*y + q*w^2*x^2 := by ring
theorem spectral_actual_degree_2_x (x y w v b q c : ℝ) : HasDerivAt (fun t : ℝ => c*q*(b + t*w + v*y)^2) (2*c*q*w*(b + v*y + w*x)) x := by
  convert (((hasDerivAt_const x (c)).mul (hasDerivAt_const x (q))).mul ((((hasDerivAt_const x (b)).add (hasDerivAt_const x (v*y))).add ((hasDerivAt_const x (w)).mul (hasDerivAt_id x))).pow 2)) using 1 <;> (try funext t) <;> (try dsimp) <;> ring
