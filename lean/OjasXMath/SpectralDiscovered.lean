theorem spectral_discovered_degree_6_gradient_v (x y w v b q c : ℝ) : 6*c*q*y*(b + v*y + w*x)^5 = 6*b^5*c*q*y + 30*b^4*c*q*v*y^2 + 30*b^4*c*q*w*x*y + 60*b^3*c*q*v^2*y^3 + 120*b^3*c*q*v*w*x*y^2 + 60*b^3*c*q*w^2*x^2*y + 60*b^2*c*q*v^3*y^4 + 180*b^2*c*q*v^2*w*x*y^3 + 180*b^2*c*q*v*w^2*x^2*y^2 + 60*b^2*c*q*w^3*x^3*y + 30*b*c*q*v^4*y^5 + 120*b*c*q*v^3*w*x*y^4 + 180*b*c*q*v^2*w^2*x^2*y^3 + 120*b*c*q*v*w^3*x^3*y^2 + 30*b*c*q*w^4*x^4*y + 6*c*q*v^5*y^6 + 30*c*q*v^4*w*x*y^5 + 60*c*q*v^3*w^2*x^2*y^4 + 60*c*q*v^2*w^3*x^3*y^3 + 30*c*q*v*w^4*x^4*y^2 + 6*c*q*w^5*x^5*y := by ring
