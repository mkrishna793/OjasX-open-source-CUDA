theorem spectral_discovered_degree_6_gradient_q (x y w v b q c : ℝ) : c*(b + v*y + w*x)^6 = b^6*c + 6*b^5*c*v*y + 6*b^5*c*w*x + 15*b^4*c*v^2*y^2 + 30*b^4*c*v*w*x*y + 15*b^4*c*w^2*x^2 + 20*b^3*c*v^3*y^3 + 60*b^3*c*v^2*w*x*y^2 + 60*b^3*c*v*w^2*x^2*y + 20*b^3*c*w^3*x^3 + 15*b^2*c*v^4*y^4 + 60*b^2*c*v^3*w*x*y^3 + 90*b^2*c*v^2*w^2*x^2*y^2 + 60*b^2*c*v*w^3*x^3*y + 15*b^2*c*w^4*x^4 + 6*b*c*v^5*y^5 + 30*b*c*v^4*w*x*y^4 + 60*b*c*v^3*w^2*x^2*y^3 + 60*b*c*v^2*w^3*x^3*y^2 + 30*b*c*v*w^4*x^4*y + 6*b*c*w^5*x^5 + c*v^6*y^6 + 6*c*v^5*w*x*y^5 + 15*c*v^4*w^2*x^2*y^4 + 20*c*v^3*w^3*x^3*y^3 + 15*c*v^2*w^4*x^4*y^2 + 6*c*v*w^5*x^5*y + c*w^6*x^6 := by ring
theorem spectral_discovered_degree_6_gradient_c (x y w v b q c : ℝ) : q*(b + v*y + w*x)^6 = b^6*q + 6*b^5*q*v*y + 6*b^5*q*w*x + 15*b^4*q*v^2*y^2 + 30*b^4*q*v*w*x*y + 15*b^4*q*w^2*x^2 + 20*b^3*q*v^3*y^3 + 60*b^3*q*v^2*w*x*y^2 + 60*b^3*q*v*w^2*x^2*y + 20*b^3*q*w^3*x^3 + 15*b^2*q*v^4*y^4 + 60*b^2*q*v^3*w*x*y^3 + 90*b^2*q*v^2*w^2*x^2*y^2 + 60*b^2*q*v*w^3*x^3*y + 15*b^2*q*w^4*x^4 + 6*b*q*v^5*y^5 + 30*b*q*v^4*w*x*y^4 + 60*b*q*v^3*w^2*x^2*y^3 + 60*b*q*v^2*w^3*x^3*y^2 + 30*b*q*v*w^4*x^4*y + 6*b*q*w^5*x^5 + q*v^6*y^6 + 6*q*v^5*w*x*y^5 + 15*q*v^4*w^2*x^2*y^4 + 20*q*v^3*w^3*x^3*y^3 + 15*q*v^2*w^4*x^4*y^2 + 6*q*v*w^5*x^5*y + q*w^6*x^6 := by ring
theorem spectral_actual_degree_6_x (x y w v b q c : ℝ) : HasDerivAt (fun t : ℝ => c*q*(b + t*w + v*y)^6) (6*c*q*w*(b + v*y + w*x)^5) x := by
  convert (((hasDerivAt_const x (c)).mul (hasDerivAt_const x (q))).mul ((((hasDerivAt_const x (b)).add (hasDerivAt_const x (v*y))).add ((hasDerivAt_const x (w)).mul (hasDerivAt_id x))).pow 6)) using 1 <;> (try funext t) <;> (try dsimp) <;> ring
